<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The web view compiles JavaScript at run time. Without these the page
         runs far slower under the hardened runtime and some pages fail
         outright. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The hardened runtime denies the microphone and the camera unless the
         app asks for them here, and an app the launcher opened in its own
         window asks through this application. Without these the system prompt
         never appears and the request is denied with nothing said. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- The launcher's whole job is to run a Python it carries. Without this
         the hardened runtime refuses to execute the bundled interpreter as a
         child of a signed app. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
